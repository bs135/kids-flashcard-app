# ==============================================================================
# Kids Flashcard App - VPS Production Configuration
# ==============================================================================

# 1. Domain Name Configuration for Caddy automatic SSL/TLS
# Example: flashcards.chipfc.com (do not include http:// or https://)
DOMAIN_NAME=flashcards.chipfc.com

# 2. Backend Server Networking (Default: 3001)
PORT=3001
HOST=0.0.0.0
NODE_ENV=production

# 3. Google Gemini API Key (Required for AI vocabulary generation)
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# 4. Feature Flags & Rate Limiting
# Enable/disable automatic AI image generation (true = Unsplash/AI, false = manual upload)
IMAGE_AI_GENERATE_ENABLE=false

# Enable/disable AI Flashcard generator (true = enabled, false = locked)
FLASHCARD_GENERATE_ENABLE=true

# Daily generation rate limit per client IP (0 = unlimited)
FLASHCARD_GENERATE_RATE_LIMIT=5
