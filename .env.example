# ==============================================================================
# Kids Flashcard App - VPS Production Configuration
# ==============================================================================

# 1. Cấu hình Tên miền (Domain Name) cho Caddy SSL tự động
# Ví dụ: flashcards.chipfc.com (không điền http:// hoặc https://)
DOMAIN_NAME=flashcards.chipfc.com

# 2. Cổng mạng backend (Mặc định: 3001)
PORT=3001
HOST=0.0.0.0
NODE_ENV=production

# 3. Google Gemini API Key (Bắt buộc để sinh từ vựng AI)
# Lấy khóa tại: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# 4. Feature Flags & Rate Limiting
# Bật/tắt sinh ảnh tự động (true = Unsplash/AI, false = tải ảnh thủ công)
IMAGE_AI_GENERATE_ENABLE=false

# Bật/tắt tính năng tạo thẻ Flashcard tự động (true = bật, false = tạm khóa)
FLASHCARD_GENERATE_ENABLE=true

# Giới hạn số lượt tạo thẻ mỗi ngày trên từng IP (0 = không giới hạn)
FLASHCARD_GENERATE_RATE_LIMIT=5
