# ==============================================================================
# Nginx Reverse Proxy Configuration for Kids Flashcard App
# Target path on Ubuntu/Debian VPS: /etc/nginx/sites-available/flashcards.chipfc.com
# ==============================================================================

server {
    listen 80;
    listen [::]:80;
    server_name flashcards.chipfc.com;

    # Allow image file uploads up to 20MB
    client_max_body_size 20M;

    location / {
        # Reverse proxy to the app container listening on localhost:3001
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;

        # Header configuration for WebSocket and client real IP support
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;

        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Timeout settings for AI vocabulary & audio generation tasks
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 120s;
    }
}