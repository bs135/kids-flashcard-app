# Server Networking Configuration
HOST=0.0.0.0
PORT=3001

# API Keys Configuration (Optional)
# 1. Google Gemini API (Get free key at: https://aistudio.google.com/)
GEMINI_API_KEY=

# 2. Unsplash API (Get Access Key at: https://unsplash.com/developers)
UNSPLASH_ACCESS_KEY=

# 3. Pexels API (Get API Key at: https://www.pexels.com/api/)
PEXELS_API_KEY=

# Feature Flags & Rate Limiting Configuration (Flashcard Generator)
FLASHCARD_GENERATE_ENABLE=true
FLASHCARD_GENERATE_RATE_LIMIT=5
IMAGE_AI_GENERATE_ENABLE=false
