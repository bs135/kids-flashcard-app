# Cấu hình server
HOST=0.0.0.0
PORT=3001

# Cấu hình API Keys (Tùy chọn)
# 1. Google Gemini API (Lấy miễn phí tại: https://aistudio.google.com/)
GEMINI_API_KEY=

# 2. Unsplash API (Lấy Access Key tại: https://unsplash.com/developers)
UNSPLASH_ACCESS_KEY=

# 3. Pexels API (Lấy API Key tại: https://www.pexels.com/api/)
PEXELS_API_KEY=

# Cấu hình Feature Flags & Rate Limit (Tạo Thẻ Flashcard)
FLASHCARD_GENERATE_ENABLE=true
FLASHCARD_GENERATE_RATE_LIMIT=5
IMAGE_AI_GENERATE_ENABLE=false
